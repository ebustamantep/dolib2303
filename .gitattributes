# Normaliza los finales de línea según el sistema operativo
* text=auto

# Archivos de texto que siempre deben usar LF
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.tpl text eol=lf
*.tpl.php text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.env text eol=lf

# Binarios - no tocar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Imágenes SVG y fuentes - tratar como texto
*.svg text eol=lf
